# Keep these values server-side. Do not use a VITE_ prefix or put the API key in browser code.
ELEVENLABS_API_KEY=

# Pick a licensed, child-friendly ElevenLabs voice in your ElevenLabs account.
ELEVENLABS_VOICE_ID=

# English defaults to ElevenLabs Matilda; override only after listening tests.
ELEVENLABS_ENGLISH_VOICE_ID=XrExE9yKIg1WjnnlVkGX

# German must be a separate native German voice; there is no English fallback.
ELEVENLABS_GERMAN_VOICE_ID=

# Optional model used for both language-specific voices.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# A public on/off switch for the browser. Set to true only after the server-side values above are configured.
VITE_ELEVENLABS_ENABLED=false
