{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "dinospace-eight.vercel.app" }],
      "destination": "https://dinospace.netlify.app/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "dinospace-eight.vercel.app" }],
      "destination": "https://dinospace.netlify.app/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
