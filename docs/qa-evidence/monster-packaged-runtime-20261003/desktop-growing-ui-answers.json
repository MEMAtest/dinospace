await (async page => {
 const rec=[];
 for(let i=0;i<6;i++){
  const heading=await page.getByRole('heading',{level:2}).last().innerText();
  const body=await page.locator('body').innerText();
  const match=body.match(/(\d+)\s*([+−-])\s*(\d+)\s*=\s*\?/);
  if(!match) throw new Error('No visible equation in UI for '+heading+'\n'+body.slice(-500));
  const a=Number(match[1]),op=match[2],b=Number(match[3]),answer=op==='+'?a+b:a-b;
  const visibleEquation=match[0];
  await page.getByRole('button',{name:String(answer),exact:true}).click();
  const next=page.getByRole('button',{name:/Next question|Finish episode/}).last();
  await next.waitFor({state:'visible',timeout:3000});
  const feedback=(await page.locator('body').innerText()).slice(-450);
  rec.push({heading,visibleEquation,answerSelected:String(answer),heldFeedback:feedback});
  if(i<5) { await next.click(); await page.waitForTimeout(600); }
 }
 return rec;
}
)(page);
