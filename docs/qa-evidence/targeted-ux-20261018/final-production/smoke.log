await home();await page.locator('.discovery-world-card').filter({hasText:'Creative Lab'}).click();await page.locator('.catalogue-game-card').filter({hasText:'Code Cadets'}).click();await page.getByRole('button',{name:'Start my first mission →',exact:true}).click();await page.evaluate(()=>scrollTo(0,0));const b=await page.locator('.cc-main-action').boundingBox();if(b.y+b.height>844)throw Error('First action below fold');for(let i=1;i<=3;i++)await page.getByRole('button',{name:`↑ Add Forward · ${i} of 3`,exact:true}).click();await page.getByRole('button',{name:'▶ Run my first program',exact:true}).click();await page.getByRole('button',{name:'Next mission →',exact:true}).waitFor();await page.screenshot({path:'output/playwright/targeted-ux-final-production-20261018/preview-code-first-'+width+'.png',fullPage:true});await page.getByRole('button',{name:'Next mission →',exact:true}).click();rows.push({width,curriculumLearnPlayFact:true,codingFirstMission:true});
