nce", "prompt": "Which source could help us investigate a castle long ago?", "options": [{"id": "castle-artefact", "label": "An artefact found there", "emoji": "\ud83c\udffa"}, {"id": "weather-app", "label": "Today\u2019s weather app", "emoji": "\ud83d\udcf1"}, {"id": "future-map", "label": "A map of a future city", "emoji": "\ud83d\udef8"}], "answer": "castle-artefact", "explanation": "An artefact is one object from the past. Historians compare it with other sources.", "wrongFeedback": "Look for something connected to the castle in the past. Historians compare more than one clue."}, {"id": "history-communication", "type": "sequence", "prompt": "Put these ways to send a message from oldest to newest.", "items": [{"id": "letter", "label": "Handwritten letter", "emoji": "\u2709\ufe0f", "order": 1}, {"id": "telephone", "label": "Landline telephone", "emoji": "\u260e\ufe0f", "order": 2}, {"id": "smartphone", "label": "Smartphone message", "emoji": "\ud83d\udcf1", "order": 3}], "explanation": "A handwritten letter is older than a landline telephone, which is older than a smartphone message."}, {"id": "history-light", "type": "sequence", "prompt": "Put these lights from oldest to newest.", "items": [{"id": "fire", "label": "Fire", "emoji": "\ud83d\udd25", "order": 1}, {"id": "candle", "label": "Candle", "emoji": "\ud83d\udd6f\ufe0f", "order": 2}, {"id": "lightbulb", "label": "Electric lightbulb", "emoji": "\ud83d\udca1", "order": 3}], "explanation": "People used fire before candles, and electric lightbulbs came later."}, {"id": "history-source-limit", "type": "evidence", "prompt": "A photograph of an old house can show us what?", "options": [{"id": "appearance", "label": "What it looked like", "emoji": "\ud83c\udfe0"}, {"id": "every-thought", "label": "Every person\u2019s thoughts", "emoji": "\ud83d\udcad"}, {"id": "tomorrow", "label": "What happens tomorrow", "emoji": "\ud83d\udd2e"}], "answer": "appearance", "explanation": "A photograph is useful evidence for what a place looked like, but it cannot show every thought.", "wrongFeedback": "Sources have limits: a photograph can show what we see, not someone\u2019s thoughts."}], "growing": [{"id": "history-photos", "type": "evidence", "prompt": "A time detective wants to learn what an old seaside holiday looked like. Which clue is most useful?", "options": [{"id": "old-photo", "label": "An old photograph", "emoji": "\ud83d\udcf7"}, {"id": "new-toy", "label": "A toy bought yesterday", "emoji": "\ud83e\uddf8"}, {"id": "guess", "label": "A wild guess", "emoji": "\ud83d\udcad"}], "answer": "old-photo", "explanation": "An old photograph can show visible details, but it cannot tell us everything people thought or felt.", "wrongFeedback": "Choose a clue made at the time. A source can help, but every source has limits."}, {"id": "history-castle", "type": "evidence", "prompt": "Which source could help us investigate a castle long ago?", "options": [{"id": "castle-artefact", "label": "An artefact found there", "emoji": "\ud83c\udffa"}, {"id": "weather-app", "label": "Today\u2019s weather app", "emoji": "\ud83d\udcf1"}, {"id": "future-map", "label": "A map of a future city", "emoji": "\ud83d\udef8"}], "answer": "castle-artefact", "explanation": "An artefact is one object from the past. Historians compare it with other sources.", "wrongFeedback": "Look for something connected to the castle in the past. Historians compare more than one clue."}, {"id": "history-communication", "type": "sequence", "prompt": "Put these ways to send a message from oldest to newest.", "items": [{"id": "letter", "label": "Handwritten letter", "emoji": "\u2709\ufe0f", "order": 1}, {"id": "telephone", "label": "Landline telephone", "emoji": "\u260e\ufe0f", "order": 2}, {"id": "smartphone", "label": "Smartphone message", "emoji": "\ud83d\udcf1", "order": 3}], "explanation": "A handwritten letter is older than a landline telephone, which is older than a smartphone message."}, {"id": "history-light", "type": "sequence", "prompt": "Put these lights from oldest to newest.", "items": [{"id": "fire", "label": "Fire", "emoji": "\ud83d\udd25", "order": 1}, {"id": "candle", "label": "Candle", "emoji": "\ud83d\udd6f\ufe0f", "order": 2}, {"id": "lightbulb", "label": "Electric lightbulb", "emoji": "\ud83d\udca1", "order": 3}], "explanation": "People used fire before candles, and electric lightbulbs came later."}, {"id": "history-source-limit", "type": "evidence", "prompt": "A photograph of an old house can show us what?", "options": [{"id": "appearance", "label": "What it looked like", "emoji": "\ud83c\udfe0"}, {"id": "every-thought", "label": "Every person\u2019s thoughts", "emoji": "\ud83d\udcad"}, {"id": "tomorrow", "label": "What happens tomorrow", "emoji": "\ud83d\udd2e"}], "answer": "appearance", "explanation": "A photograph is useful evidence for what a place looked like, but it cannot show every thought.", "wrongFeedback": "Sources have limits: a photograph can show what we see, not someone\u2019s thoughts."}, {"id": "history-local-school", "type": "evidence", "prompt": "Which clues could help us find out how a local school changed?", "options": [{"id": "photos-interview", "label": "Old photos and an interview", "emoji": "\ud83d\udcf8"}, {"id": "one-guess", "label": "One modern guess", "emoji": "\ud83c\udfb2"}, {"id": "tomorrow-weather", "label": "Tomorrow\u2019s weather", "emoji": "\u2601\ufe0f"}], "answer": "photos-interview", "explanation": "Photographs and an interview give different clues. Memories and pictures can both leave things out.", "wrongFeedback": "Local historians compare clues connected to the place, such as photographs and people\u2019s memories."}, {"id": "history-personal-sequence", "type": "sequence", "prompt": "Put these parts of a person\u2019s story from earliest to latest.", "items": [{"id": "baby", "label": "Baby", "emoji": "\ud83d\udc76", "order": 1}, {"id": "child", "label": "Child", "emoji": "\ud83e\uddd2", "order": 2}, {"id": "adult", "label": "Adult", "emoji